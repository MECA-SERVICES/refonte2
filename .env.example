# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Verrou de préproduction
# Tant que cette variable est renseignée, TOUT le site (vitrine, back-office,
# API) exige ce mot de passe. La vider — ou la supprimer — ouvre le site au
# public. Laisser vide en local.
SITE_PASSWORD=""
