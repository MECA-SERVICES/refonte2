# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Verrou de préproduction
# Tant que cette variable est renseignée, TOUT le site (vitrine, back-office,
# API) exige ce mot de passe. La vider — ou la supprimer — ouvre le site au
# public. Laisser vide en local.
SITE_PASSWORD=""

# Paiement par carte bancaire — Monetico (CDC 20)
# TPE, société et clé MAC (40 caractères hexadécimaux) sont fournis avec le
# contrat Crédit Mutuel / CIC.
MONETICO_TPE=
MONETICO_SOCIETE=
MONETICO_CLE_MAC=

# URL du serveur de paiement : c'est ELLE, et elle seule, qui décide si une
# transaction est réelle — les identifiants sont les mêmes dans les deux modes.
#   test       https://paiement.creditmutuel.fr/test/paiement.cgi
#   production https://paiement.creditmutuel.fr/paiement.cgi
# Non renseignée, l'URL de test s'applique : un oubli n'encaisse jamais.
MONETICO_URL=https://paiement.creditmutuel.fr/test/paiement.cgi

# Recherche — Meilisearch
# URL publique de l'instance. Sans URL ni clé applicative, la boutique garde
# la recherche SQL (trigrammes) : rien ne casse, la recherche est moins bonne.
MEILI_URL=""
# Clé de l'application (recherche + mise à jour des fiches), créée par
# `bun run search:reindex -- --setup`. Jamais la clé maître.
MEILI_API_KEY=""
# Clé maître : scripts d'indexation uniquement (`bun run search:*`).
MEILI_MASTER_KEY=""
